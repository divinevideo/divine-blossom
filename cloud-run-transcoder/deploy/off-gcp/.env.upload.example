# Copy to .env.upload on the worker host (chmod 600 .env.upload) and fill in secrets.
# Never commit a populated .env.upload file.

# Public endpoints
# Set UPLOAD_BASE_URL to the candidate hostname (e.g. https://upload-hetzner.divine.video)
# during staging so /upload/init returns candidate-host /sessions/:id URLs, then switch
# to https://upload.divine.video and recreate the upload container before DNS cutover.
CDN_BASE_URL=https://media.divine.video
UPLOAD_BASE_URL=https://upload.divine.video
RUST_LOG=info

# Resumable upload framing
RESUMABLE_SESSION_TTL_SECS=86400
RESUMABLE_CHUNK_SIZE=1048576
RESUMABLE_MAX_REQUEST_BODY_SIZE=16777216

# Concurrency & thumbnail extraction tuning (bounded by UPLOAD_CPUS in docker-compose.upload.yml)
MAX_CONCURRENT_UPLOADS=16
MAX_CONCURRENT_THUMBNAILS=12
THUMBNAIL_WAIT_SECS=6
MAX_CONCURRENT_MIRRORS=2
# Optional resource overrides (verify parity with live GKE production before enabling):
# MAX_UPLOAD_BYTES=1073741824
# MIRROR_FETCH_TIMEOUT_SECS=120

# Primary Backblaze B2 object storage + GCS compatibility dual-write
# B2_MEDIA_BUCKET=divine-media-canary matches live GKE production divine-upload-server
# today; verify all bucket and write-mode settings against live GKE production before
# enabling so GKE and Hetzner share object storage and resumable sessions cleanly.
MEDIA_WRITE_PROVIDER=b2_primary
GCS_COMPAT_ENABLED=true
GCS_BUCKET=divine-blossom-media
B2_MEDIA_BUCKET=divine-media-canary
B2_REGION=us-east-005
B2_ACCESS_KEY_ID=REPLACE_ME
B2_SECRET_ACCESS_KEY=REPLACE_ME

# Downstream transcoder & transcription handoff
# Default to the Cloud Run origin with TRANSCODE_ADMISSION_SECRET unset (matching live GKE
# production). Setting TRANSCODE_ADMISSION_SECRET overrides TRANSCODER_URL and routes HLS
# intake to https://transcoder-worker.divine.video/transcode/queue, which returns 404 unless
# the worker enables TRANSCODE_ADMISSION_AUTH_REQUIRED=true with a matching secret and
# container-to-host HTTPS hairpinning works.
# TRANSCRIBER_URL must point to an origin that serves POST /transcribe/audio; the off-GCP
# worker's public Caddyfile intentionally returns 404 for /transcribe/audio. Keep the
# Cloud Run transcription origin below (matching live GKE production) unless you switch
# to internal http://transcoder:8080 on a worker configured with transcription credentials
# and a matching TRANSCRIBE_SHARED_SECRET.
TRANSCODER_URL=https://divine-transcoder-149672065768.us-central1.run.app
TRANSCRIBER_URL=https://divine-transcoder-149672065768.us-central1.run.app
# TRANSCODE_ADMISSION_SECRET=
TRANSCRIBE_SHARED_SECRET=REPLACE_ME

# Optional feature parity keys (copy from live GKE production if configured there):
# MIGRATION_NSEC=
# AI_DETECTOR_BASE_URL=

# Observability (set SENTRY_DSN to the real DSN, or leave commented to disable Sentry)
SENTRY_ENVIRONMENT=production
# SENTRY_DSN=
