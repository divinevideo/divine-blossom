{$TRANSCODER_DOMAIN} {
	@worker_routes {
		# Expose the queue-only route only with the worker's required-auth flag.
		expression `path('/health', '/internal/transcode', '/transcode', '/backfill-fmp4', '/transcribe', '/translate') || (path('/transcode/queue') && {env.TRANSCODE_ADMISSION_AUTH_REQUIRED} == 'true')`
	}

	handle @worker_routes {
		reverse_proxy transcoder:8080 {
			transport http {
				dial_timeout 10s
				# Match Cloud Tasks dispatchDeadline (900s) for long transcode jobs.
				response_header_timeout 910s
				read_timeout 910s
				write_timeout 910s
			}
		}
	}

	handle {
		respond 404
	}
}
