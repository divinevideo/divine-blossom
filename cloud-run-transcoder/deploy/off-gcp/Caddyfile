{
	# Publish only HTTP/1.1 and HTTP/2 because docker-compose.yml maps TCP 443
	# only; avoids advertising Alt-Svc h3 over an unpublished UDP 443 port.
	# Cap total request-body read duration across HTTP/1.1 and HTTP/2 streams
	# (~450 kbit/s minimum for a full 16 MiB direct PUT; 1 MiB resumable chunks
	# work down to ~28 kbit/s). Transcoder responses still stream up to 910s via
	# reverse_proxy timeouts because Go clears the read deadline after reading the request.
	servers {
		protocols h1 h2
		timeouts {
			read_body 300s
		}
	}
}

{$TRANSCODER_DOMAIN} {
	@worker_routes <<CEL
		path('/health', '/internal/transcode', '/backfill-fmp4', '/transcribe', '/translate')
		|| (path('/transcode') && {env.TRANSCODE_ADMISSION_AUTH_REQUIRED} in ['false', '0'])
		|| (path('/transcode', '/transcode/queue') && {env.TRANSCODE_ADMISSION_AUTH_REQUIRED} == 'true'
			&& {env.TRANSCODE_ADMISSION_SECRET} != ''
			&& {http.request.header.X-Divine-Transcode-Admission} == {env.TRANSCODE_ADMISSION_SECRET})
		CEL
	@rejected_admission `path('/transcode', '/transcode/queue') && {env.TRANSCODE_ADMISSION_AUTH_REQUIRED} == 'true'`

	handle @worker_routes {
		reverse_proxy transcoder:8080 {
			transport http {
				dial_timeout 10s
				# Match Cloud Tasks dispatchDeadline (900s) for long transcode jobs.
				response_header_timeout 910s
				read_timeout 910s
				write_timeout 910s
			}
		}
	}

	handle @rejected_admission {
		respond 401
	}

	handle {
		respond 404
	}
}

# Optional additional site blocks (e.g. conf.d/upload.caddy for co-located
# divine-upload-server). Caddy ignores this glob when conf.d has no *.caddy files.
import /etc/caddy/conf.d/*.caddy
