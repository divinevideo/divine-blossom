# Copy to .env on the worker host (chmod 600 .env) and fill in secrets.
# Never commit a populated .env file.

TRANSCODER_DOMAIN=transcoder-worker.divine.video
TRANSCODER_IMAGE=gcr.io/rich-compiler-479518-d2/divine-transcoder:cpu-latest
GCP_SA_KEY_PATH=/etc/divine-transcoder/gcp-sa.json

# GCP project & single-writer claim bucket
GCP_PROJECT_ID=rich-compiler-479518-d2
GCS_BUCKET=divine-blossom-media

# Primary Backblaze B2 object storage (no GCP egress when hosted on Vultr US East / Hetzner US)
MEDIA_STORAGE_PROVIDER=b2_primary
MEDIA_GCS_BACKUP_ENABLED=false
B2_MEDIA_BUCKET=divine-media-canary
B2_REGION=us-east-005
B2_ACCESS_KEY_ID=REPLACE_ME
B2_SECRET_ACCESS_KEY=REPLACE_ME

# Cloud Tasks worker authentication (must match Secret Manager hls_transcode_dispatch:1)
TRANSCODE_QUEUE=projects/rich-compiler-479518-d2/locations/us-central1/queues/divine-transcode
TRANSCODE_WORKER_URL=https://transcoder-worker.divine.video
TRANSCODE_DISPATCH_SECRET=REPLACE_ME

# Completion webhooks back to Fastly edge
WEBHOOK_URL=https://media.divine.video/admin/transcode-status
TRANSCRIPT_WEBHOOK_URL=https://media.divine.video/admin/transcript-status
WEBHOOK_SECRET=REPLACE_ME

# Transcription & audio analysis
TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-2.5-flash
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=REPLACE_ME
TRANSCRIBE_SHARED_SECRET=REPLACE_ME
TRANSLATE_SHARED_SECRET=REPLACE_ME
PARAKEET_ASR_URL=https://divine-asr-parakeet-nr3owfkrxa-uk.a.run.app
AUDIO_ANALYZER_URL=https://divine-audio-analyzer-nr3owfkrxa-uc.a.run.app
STATUS_QUEUE_ENABLED=false
STATUS_QUEUE_LOCATION=us-central1
STATUS_QUEUE_NAME=derivative-status
SENTRY_ENVIRONMENT=production
SENTRY_DSN=REPLACE_ME
